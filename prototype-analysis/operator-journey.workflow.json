      {
        "id": "audience",
        "label": "Audience intake",
        "focus": [
          "csv",
          "detect",
          "rows"
        ],
        "note": "The data team's CSV is parsed in the browser, roles detected, and uploaded in batches; bad numbers are separated with a reason."
      },
      {
        "id": "template",
        "label": "Template approval",
        "focus": [
          "compose",
          "rules",
          "review",
          "rejected"
        ],
        "note": "Drafts are checked against Meta's authoring rules before submission, because a rejected name is locked for 30 days."
      },
      {
        "id": "campaign",
        "label": "Campaign send",
        "focus": [
          "wizard",
          "fire",
          "overlap",
          "delivery",
          "logs"
        ],
        "note": "The wizard maps variables to CSV columns; firing runs the guards, then sends and records receipts."
      }
    ],
