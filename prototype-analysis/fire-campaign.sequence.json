          "operator",
          "ui",
          "fire",
          "auth",
          "db"
        ],
        "note": "Session revalidation, template/audience checks, the per-recipient overlap guard and the atomic claim all run before any message leaves."
      },
      {
        "id": "send",
        "label": "Background send",
        "focus": [
          "fire",
          "meta",
          "db"
        ],
        "note": "after() keeps the invocation alive; 8 workers share a cursor and logs flush in batches of 50."
      },
      {
        "id": "receipts",
        "label": "Delivery receipts",
        "focus": [
          "meta",
          "webhook",
          "db"
        ],
        "note": "Meta reports delivered/read/failed asynchronously; the webhook patches message_logs and campaign counters."
      }
    ]
